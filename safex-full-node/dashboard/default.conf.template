server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    location / {
        try_files $uri $uri/ /index.html;
    }

    location /api/get_info {
        proxy_pass http://node:17402/get_info;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
    }

    # Stratum (xmrig-proxy) HTTP API. The token never reaches the browser: nginx injects it.
    # The dashboard itself is protected by Umbrel's app_proxy login.
    location ~ ^/stratum-api/1/(summary|workers|config)$ {
        resolver 127.0.0.11 valid=10s;  # Docker DNS; needed because proxy_pass uses a variable
        proxy_pass http://stratum:8080/1/$1;
        proxy_http_version 1.1;
        proxy_set_header Authorization "Bearer ${STRATUM_API_TOKEN}";
        proxy_set_header Content-Type "application/json";
        proxy_read_timeout 10s;
    }
}
